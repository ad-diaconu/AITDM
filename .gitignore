# Python / virtual environment
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Data (downloaded / generated, never committed: regenerate it with data_splitting/)
# No trailing slash: on fep this is a link to ~/AITDM_Project/data (Fep/setup_fep.sh)
/data

# Run artefacts. outputs/ IS committed (results.json, summaries, reports), but not the
# model weights; logs stay out
/logs
lightning_logs/
*.pt
*.pth
*.fab

# OS / editor
.DS_Store
__MACOSX/
.idea/
.vscode/

# Ad-hoc runs of scripts/run_simulation.sh / submit_run.sh (experiment results come from
# experiments/run_seeds.py and centralised.py and ARE committed)
/outputs/sim-*/
/outputs/deploy-*/

# Claude Code: skills and review notes are personal (each person keeps their own), except the
# shared /push skill; the agents in .claude/agents/ and .claude/experiment-review.md ARE shared.
# gh-backlog: the sync script and SKILL.md.example are shared; your own SKILL.md (a copy) is not
/.claude/skills/*
!/.claude/skills/push/
!/.claude/skills/gh-backlog/
/.claude/skills/gh-backlog/SKILL.md
/.claude/reviews/
/.claude/settings.local.json
